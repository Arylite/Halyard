<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Halyard.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Halyard.Controls"
    xmlns:vm="using:Halyard.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Logs">
            <controls:PageHeader.Actions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.ExportReportCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Zip logs, settings and system info for a bug report (no tokens)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEBE8;" />
                        <TextBlock Text="Export report" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.CopyVisibleCommand}" ToolTipService.ToolTip="Copy visible entries">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}" ToolTipService.ToolTip="Open the log files folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                        <TextBlock Text="Open folder" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Filter by message or source" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                ItemsSource="{x:Bind ViewModel.LevelNames}"
                SelectedIndex="{x:Bind ViewModel.MinimumLevelIndex, Mode=TwoWay}"
                ToolTipService.ToolTip="Minimum level" />
            <ToggleButton
                Grid.Column="2"
                IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}"
                ToolTipService.ToolTip="Follow new entries">
                <FontIcon FontSize="14" Glyph="&#xE74B;" />
            </ToggleButton>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="0,4"
            Style="{StaticResource CardStyle}">
            <ListView
                x:Name="EntriesList"
                ItemsSource="{x:Bind ViewModel.Entries}"
                SelectionMode="Extended">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntryItem">
                        <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Time}" />
                            <TextBlock
                                Grid.Column="1"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                Text="{x:Bind LevelText}" />
                            <TextBlock
                                Grid.Column="2"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Category}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Message}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
