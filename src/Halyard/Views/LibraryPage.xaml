<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Halyard.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Halyard.Controls"
    xmlns:vm="using:Halyard.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Library">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh the library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="14" Height="14">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.AddGameCommand}" ToolTipService.ToolTip="Add any executable to the library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add game" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid
            Grid.Row="1"
            ColumnSpacing="16"
            RowSpacing="8"
            SizeChanged="OnToolbarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SearchColumn" Width="2*" MaxWidth="520" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="FilterBar" SelectionChanged="OnFilterChanged">
                <SelectorBarItem Text="All games" />
                <SelectorBarItem Text="Installed" />
                <SelectorBarItem Text="Updates" />
                <SelectorBarItem Text="Not installed" />
            </SelectorBar>
            <Grid
                x:Name="SearchArea"
                Grid.Column="1"
                VerticalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    PlaceholderText="Search your library"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="160"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="Sort by" />
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE7FC;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            Margin="0,0,-16,0"
            Padding="0,0,16,0"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater controls:Motion.StaggerEntrance="True" ItemsSource="{x:Bind ViewModel.Games}">
                <ItemsRepeater.Layout>
                    <!--  Uniform: cards widen to fill each row and keep their proportions.  -->
                    <UniformGridLayout
                        ItemsStretch="Uniform"
                        MinColumnSpacing="16"
                        MinItemHeight="340"
                        MinItemWidth="190"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameItemViewModel">
                        <Grid
                            controls:Motion.HoverLift="True"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Initials, Mode=OneWay}"
                                    Visibility="{x:Bind ShowInitials, Mode=OneWay}" />
                                <Image
                                    controls:FadeInImage.IsEnabled="True"
                                    controls:Motion.ZoomOnHover="True"
                                    Source="{x:Bind Cover, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Grid>

                            <StackPanel Grid.Row="1" Padding="12,10,12,12">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                                <ProgressBar
                                    Margin="0,8,0,0"
                                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                    ShowPaused="{x:Bind IsProgressPaused, Mode=OneWay}"
                                    Visibility="{x:Bind ShowProgress, Mode=OneWay}"
                                    Value="{x:Bind ProgressPercent, Mode=OneWay}" />

                                <Grid Margin="0,10,0,0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind InstallCommand}"
                                        Content="Install"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ShowInstall, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind PlayCommand}"
                                        Content="Play"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ShowPlay, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind InstallUpdateCommand}"
                                        Content="Update"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ShowUpdate, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewDownloadCommand}"
                                        Content="View download"
                                        Visibility="{x:Bind ShowViewDownload, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind StopCommand}"
                                        Content="Stop"
                                        Visibility="{x:Bind ShowStop, Mode=OneWay}" />

                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="More actions"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="More"
                                        Visibility="{x:Bind HasMoreActions, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem
                                                    Command="{x:Bind ImportCommand}"
                                                    Text="Locate existing install"
                                                    Visibility="{x:Bind ShowInstall, Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8DA;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Command="{x:Bind OpenFolderCommand}"
                                                    Text="Open install folder"
                                                    Visibility="{x:Bind CanOpenFolder, Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE838;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Command="{x:Bind EditLaunchOptionsCommand}"
                                                    Text="Launch options"
                                                    Visibility="{x:Bind CanOpenFolder, Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE713;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Command="{x:Bind VerifyCommand}"
                                                    Text="Verify and repair"
                                                    Visibility="{x:Bind CanVerify, Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE9D5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Command="{x:Bind UninstallCommand}"
                                                    Text="{x:Bind UninstallText, Mode=OneWay}"
                                                    Visibility="{x:Bind CanUninstall, Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!--  Outline, drawn over the cover; a brighter one fades in while hovered.  -->
                            <Border
                                Grid.RowSpan="2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                IsHitTestVisible="False" />
                            <Border
                                Grid.RowSpan="2"
                                controls:Motion.RevealOnHover="True"
                                BorderBrush="{ThemeResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
