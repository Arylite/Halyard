<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Halyard.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Halyard.Controls"
    xmlns:vm="using:Halyard.ViewModels">

    <Page.Resources>
        <Style x:Key="StatLabelStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValueStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>

        <!--  Compact row for queued and finished jobs.  -->
        <DataTemplate x:Key="JobRowTemplate" x:DataType="vm:DownloadItemViewModel">
            <Border
                Margin="0,0,0,4"
                controls:Motion.HoverLift="True"
                Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="40"
                        Height="54"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Initials}" />
                        <Image
                            controls:FadeInImage.IsEnabled="True"
                            Source="{x:Bind Cover}"
                            Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Destination}" />
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Kind}" />
                            </Border>
                        </StackPanel>
                        <ProgressBar
                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                            ShowError="{x:Bind IsFailed, Mode=OneWay}"
                            ShowPaused="{x:Bind IsPaused, Mode=OneWay}"
                            Visibility="{x:Bind ShowProgress, Mode=OneWay}"
                            Value="{x:Bind Percent, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button AutomationProperties.Name="Details" Command="{x:Bind ShowDetailsCommand}" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Details">
                            <FontIcon FontSize="14" Glyph="&#xE946;" />
                        </Button>
                        <Button AutomationProperties.Name="Move up"
                            Command="{x:Bind MoveUpCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Move up"
                            Visibility="{x:Bind CanCancel, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE70E;" />
                        </Button>
                        <Button AutomationProperties.Name="Move down"
                            Command="{x:Bind MoveDownCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Move down"
                            Visibility="{x:Bind CanCancel, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE70D;" />
                        </Button>
                        <Button AutomationProperties.Name="{x:Bind ResumeText, Mode=OneWay}"
                            Command="{x:Bind ResumeCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ResumeText, Mode=OneWay}"
                            Visibility="{x:Bind CanResume, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                        </Button>
                        <Button AutomationProperties.Name="Pause"
                            Command="{x:Bind PauseCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Pause"
                            Visibility="{x:Bind CanPause, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE769;" />
                        </Button>
                        <Button AutomationProperties.Name="Cancel (downloaded files are kept for later)"
                            Command="{x:Bind CancelCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Cancel (downloaded files are kept for later)"
                            Visibility="{x:Bind CanCancel, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                        <Button AutomationProperties.Name="Remove from list"
                            Command="{x:Bind RemoveCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Remove from list"
                            Visibility="{x:Bind CanRemove, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Downloads">
            <controls:PageHeader.Actions>
                <Button Command="{x:Bind ViewModel.ClearFinishedCommand}" Visibility="{x:Bind ViewModel.HasFinished, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                        <TextBlock Text="Clear finished" />
                    </StackPanel>
                </Button>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!--  Empty state  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE896;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Nothing to download" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Installs, updates and repairs started from the library show up here." />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.BrowseLibraryCommand}"
                Content="Browse your library"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,-16,0"
            Padding="0,0,16,0"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

                <!--  Spotlight on the active install  -->
                <Grid Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                    <!--  The cover, blurred and dimmed, tints the spotlight.  -->
                    <Border CornerRadius="{StaticResource CardCornerRadius}">
                        <Border.Background>
                            <ImageBrush
                                ImageSource="{x:Bind ViewModel.Current.Cover, Mode=OneWay}"
                                Opacity="0.55"
                                Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="{StaticResource CardCornerRadius}">
                        <Border.Background>
                            <AcrylicBrush
                                FallbackColor="{ThemeResource SurfaceColor}"
                                TintColor="{ThemeResource SurfaceColor}"
                                TintLuminosityOpacity="0.85"
                                TintOpacity="0.8" />
                        </Border.Background>
                    </Border>
                <Border
                    Padding="24"
                    Background="Transparent"
                    Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Width="168"
                            Height="224"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.Current.Initials, Mode=OneWay}" />
                            <Image
                                controls:FadeInImage.IsEnabled="True"
                                Source="{x:Bind ViewModel.Current.Cover, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Current.Kind, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Current.Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Current.PhaseText, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Current.PercentText, Mode=OneWay}" />
                            </Grid>

                            <ProgressBar
                                MinHeight="6"
                                IsIndeterminate="{x:Bind ViewModel.Current.IsIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind ViewModel.Current.IsFailed, Mode=OneWay}"
                                ShowPaused="{x:Bind ViewModel.Current.IsPaused, Mode=OneWay}"
                                Value="{x:Bind ViewModel.Current.Percent, Mode=OneWay}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Network" />
                                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.Current.SpeedText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Disk" />
                                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.Current.DiskSpeedText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Downloaded" />
                                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.Current.AmountText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Time left" />
                                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.Current.RemainingText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="Connections" />
                                    <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.Current.ConnectionsText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!--  Speed over the last minute; the chart scales to its peak.  -->
                            <Border
                                Height="72"
                                Padding="0,4"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="4">
                                <controls:SpeedGraph Samples="{x:Bind ViewModel.Current.SpeedSamples, Mode=OneWay}" />
                            </Border>

                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Current.HasCdns, Mode=OneWay}">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="Content delivery networks" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Current.Cdns, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CdnStatViewModel">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Host}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ProgressBar
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Value="{x:Bind Share}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.Current.PauseCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.Current.CanPause, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE769;" />
                                        <TextBlock Text="Pause" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.Current.ResumeCommand, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.Current.CanResume, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock Text="Resume" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.Current.ShowDetailsCommand, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                                        <TextBlock Text="Details" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.Current.CancelCommand, Mode=OneWay}" ToolTipService.ToolTip="Downloaded files are kept for later">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>

                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Up next"
                    Visibility="{x:Bind ViewModel.HasUpcoming, Mode=OneWay}" />
                <ItemsRepeater controls:Motion.StaggerEntrance="True" ItemTemplate="{StaticResource JobRowTemplate}" ItemsSource="{x:Bind ViewModel.Upcoming}" />

                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Finished"
                    Visibility="{x:Bind ViewModel.HasFinished, Mode=OneWay}" />
                <ItemsRepeater controls:Motion.StaggerEntrance="True" ItemTemplate="{StaticResource JobRowTemplate}" ItemsSource="{x:Bind ViewModel.Finished}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
