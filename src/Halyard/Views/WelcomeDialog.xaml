<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Halyard.Views.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Halyard.Controls"
    CloseButtonText="Skip for now"
    DefaultButton="Primary"
    PrimaryButtonText="Sign in with Epic Games"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="560" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <Image
                Width="56"
                Height="56"
                Source="ms-appx:///Assets/AppIcon.ico" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Welcome to Halyard" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Your Epic Games library, installed lean and launched fast."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <controls:SettingsCard
                Description="{x:Bind Settings.InstallDirectory, Mode=OneWay}"
                Glyph="&#xE8B7;"
                Header="Where games go">
                <controls:SettingsCard.Action>
                    <Button Command="{x:Bind Settings.BrowseInstallDirectoryCommand}" Content="Browse" />
                </controls:SettingsCard.Action>
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="Starts in the notification area, so updates are ready when you are."
                Glyph="&#xE7E8;"
                Header="Launch at startup">
                <controls:SettingsCard.Action>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind Settings.LaunchAtStartup, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard.Action>
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="Spreads downloads across Epic's CDNs for more speed. Experimental."
                Glyph="&#xE7B8;"
                Header="Multi-CDN acceleration">
                <controls:SettingsCard.Action>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind Settings.ExperimentalMultiCdn, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </controls:SettingsCard.Action>
            </controls:SettingsCard>
        </StackPanel>

        <TextBlock
            Style="{StaticResource SecondaryTextStyle}"
            Text="Halyard is open source and not affiliated with Epic Games. You sign in on Epic's own page; your session is encrypted on this PC."
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
