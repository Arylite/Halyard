<?xml version="1.0" encoding="utf-8" ?>
<!--
    Halyard's look, after the classic game-launcher style: flat charcoal surfaces told apart by tone
    rather than borders, small radii, white text and one blue accent. Built by overriding Fluent's
    theme keys ("lightweight styling"), so every stock control follows without custom templates.
    High contrast has no entry here on purpose: it keeps the system colors.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Shape: square-ish, like a launcher rather than a settings app.  -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

    <!--
        Stock control templates derive their accent from these system colors, not from the brushes
        below (dark theme fills with Light2, light theme with Dark1): without them, buttons and
        indicators would follow the Windows accent color instead of Halyard's.
    -->
    <Color x:Key="SystemAccentColor">#FF0078F2</Color>
    <Color x:Key="SystemAccentColorLight1">#FF1A86F4</Color>
    <Color x:Key="SystemAccentColorLight2">#FF0078F2</Color>
    <Color x:Key="SystemAccentColorLight3">#FF5AAAFF</Color>
    <Color x:Key="SystemAccentColorDark1">#FF0070E0</Color>
    <Color x:Key="SystemAccentColorDark2">#FF005FC2</Color>
    <Color x:Key="SystemAccentColorDark3">#FF004E9F</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!--  Palette (dark): sidebar a step above the page, cards a step above that.  -->
            <Color x:Key="AppBackgroundColor">#FF202020</Color>
            <Color x:Key="ContentBackgroundColor">#FF121212</Color>
            <Color x:Key="SurfaceColor">#FF202020</Color>
            <Color x:Key="SurfaceHoverColor">#FF2A2A2A</Color>
            <Color x:Key="SurfaceRaisedColor">#FF2A2A2A</Color>
            <Color x:Key="BorderSubtleColor">#0FFFFFFF</Color>
            <Color x:Key="BorderStrongColor">#1FFFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#FFF5F5F5</Color>
            <Color x:Key="TextSecondaryColor">#FFAAAAAA</Color>
            <Color x:Key="TextTertiaryColor">#FF777777</Color>
            <Color x:Key="AccentColor">#FF0078F2</Color>
            <Color x:Key="AccentHoverColor">#FF1A86F4</Color>
            <Color x:Key="AccentPressedColor">#FF0063C7</Color>
            <Color x:Key="AccentTextColor">#FF5AAAFF</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="CoverHoverBrush" Color="#14FFFFFF" />

            <!--  Text  -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

            <!--  Accent  -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="Transparent" />

            <!--
                Fluent's dark theme puts black text on its (light) accent. Templates read these
                control keys rather than TextOnAccentFillColorPrimaryBrush above, so white has to be
                set on each of them for the blue accent.
            -->
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="InfoBadgeForeground" Color="#FFFFFFFF" />

            <!--  Surfaces  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#B3000000" />

            <!--  Controls: filled grays, no outlines.  -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF2F2F2F" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF282828" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="Transparent" />

            <!--  Shell  -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

            <!--  Overlays  -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderSubtleColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!--  Palette (light)  -->
            <Color x:Key="AppBackgroundColor">#FFEBEBEB</Color>
            <Color x:Key="ContentBackgroundColor">#FFF5F5F5</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceHoverColor">#FFF0F0F0</Color>
            <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
            <Color x:Key="BorderSubtleColor">#14000000</Color>
            <Color x:Key="BorderStrongColor">#24000000</Color>
            <Color x:Key="TextPrimaryColor">#FF121212</Color>
            <Color x:Key="TextSecondaryColor">#FF5A5A5A</Color>
            <Color x:Key="TextTertiaryColor">#FF8A8A8A</Color>
            <Color x:Key="AccentColor">#FF0070E0</Color>
            <Color x:Key="AccentHoverColor">#FF1A80E8</Color>
            <Color x:Key="AccentPressedColor">#FF005FC2</Color>
            <Color x:Key="AccentTextColor">#FF005FC2</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="CoverHoverBrush" Color="#1AFFFFFF" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="Transparent" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#08000000" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000" />

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFE4E4E4" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFDADADA" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFE9E9E9" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#14000000" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderSubtleColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
