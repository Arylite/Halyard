<?xml version="1.0" encoding="utf-8" ?>
<!--
    Halyard's look: quiet neutral surfaces, hairline borders, one indigo accent (in the spirit of
    Linear). Built by overriding the Fluent theme keys ("lightweight styling"), so every stock
    control follows without custom templates. High contrast has no entry here on purpose: it keeps
    the system colors.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Shape: slightly tighter than Fluent's defaults.  -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!--  Palette (dark)  -->
            <Color x:Key="AppBackgroundColor">#FF0D0E10</Color>
            <Color x:Key="ContentBackgroundColor">#FF121316</Color>
            <Color x:Key="SurfaceColor">#FF17181B</Color>
            <Color x:Key="SurfaceHoverColor">#FF1D1E22</Color>
            <Color x:Key="SurfaceRaisedColor">#FF1C1D21</Color>
            <Color x:Key="BorderSubtleColor">#14FFFFFF</Color>
            <Color x:Key="BorderStrongColor">#24FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#FFEEEFF1</Color>
            <Color x:Key="TextSecondaryColor">#FF9A9EA6</Color>
            <Color x:Key="TextTertiaryColor">#FF6A6E76</Color>
            <Color x:Key="AccentColor">#FF6872D9</Color>
            <Color x:Key="AccentHoverColor">#FF7780DE</Color>
            <Color x:Key="AccentPressedColor">#FF5560C6</Color>
            <Color x:Key="AccentTextColor">#FF959DEB</Color>
            <Color x:Key="AccentGlowColor">#2E5E6AD2</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

            <!--  Text  -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

            <!--  Accent  -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#26FFFFFF" />

            <!--  Surfaces  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#A6000000" />

            <!--  Controls  -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#1FFFFFFF" />

            <!--  Shell: the sidebar sits on the window background, the page on a slightly lighter panel.  -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource BorderSubtleColor}" />

            <!--  Overlays  -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderStrongColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!--  Palette (light)  -->
            <Color x:Key="AppBackgroundColor">#FFF1F2F4</Color>
            <Color x:Key="ContentBackgroundColor">#FFFBFBFC</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceHoverColor">#FFF6F7F9</Color>
            <Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color>
            <Color x:Key="BorderSubtleColor">#14000000</Color>
            <Color x:Key="BorderStrongColor">#22000000</Color>
            <Color x:Key="TextPrimaryColor">#FF1A1B1E</Color>
            <Color x:Key="TextSecondaryColor">#FF5C6068</Color>
            <Color x:Key="TextTertiaryColor">#FF8A8E96</Color>
            <Color x:Key="AccentColor">#FF5E6AD2</Color>
            <Color x:Key="AccentHoverColor">#FF6B76D8</Color>
            <Color x:Key="AccentPressedColor">#FF535EC4</Color>
            <Color x:Key="AccentTextColor">#FF4F5AC2</Color>
            <Color x:Key="AccentGlowColor">#1F5E6AD2</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#1F000000" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000" />

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF6F7F9" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFF0F1F3" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#24000000" />

            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource ContentBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource BorderSubtleColor}" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderStrongColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
