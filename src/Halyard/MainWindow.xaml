<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Halyard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Halyard.ViewModels"
    Title="Halyard">
    <!--  A flat, solid window (no Mica): the sidebar sits on it, pages on a lighter inset panel.  -->
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Halyard"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="QuickSearch"
                    MinWidth="320"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Search games (Ctrl+K)"
                    QueryIcon="Find"
                    QuerySubmitted="OnQuickSearchSubmitted"
                    TextChanged="OnQuickSearchTextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="K"
                            Invoked="OnQuickSearchShortcut"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickSearchResult">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind Action}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1100"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="260"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Library" Icon="Library" Tag="Library" />
                <NavigationViewItem Content="Downloads" Icon="Download" Tag="Downloads">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.HasActiveDownloads, Mode=OneWay}" Value="{x:Bind ViewModel.ActiveDownloads, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Logs" Tag="Logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="Settings" />
            </NavigationView.FooterMenuItems>

            <Grid>
                <!--  Faint accent glow at the top of every page.  -->
                <Rectangle
                    Height="360"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="1">
                            <GradientStop Offset="0" Color="{ThemeResource AccentGlowColor}" />
                            <GradientStop Offset="1" Color="#005E6AD2" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Frame x:Name="ContentFrame">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>

                <InfoBar
                    MaxWidth="520"
                    Margin="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    PointerEntered="OnNotificationPointerEntered"
                    PointerExited="OnNotificationPointerExited"
                    IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind ViewModel.RunNotificationActionCommand}"
                            Content="{x:Bind ViewModel.NotificationActionText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasNotificationAction, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
