<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Halyard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Halyard.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />

            <!--  Same metrics as the Windows 11 Settings app.  -->
            <Thickness x:Key="PagePadding">36,24,36,24</Thickness>
            <x:Double x:Key="CardSpacing">4</x:Double>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <!--  Small, muted section labels and a tight, bold page title.  -->
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,24,0,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="PageTitleStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>

            <Style x:Key="SecondaryTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="IconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
