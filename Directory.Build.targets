<Project>

  <!--
    Design-time builds (what C# Dev Kit / Roslyn LSP run in VS Code) skip the WinUI XAML compiler,
    so code-behind can't see InitializeComponent, x:Name fields or x:Bind code and the editor shows
    false errors. Feed those builds the sources generated by the last real build instead.
    Run a normal build once (Ctrl+Shift+B) for them to exist.
  -->
  <Target Name="IncludeXamlGeneratedCodeInDesignTimeBuild"
          BeforeTargets="CoreCompile"
          Condition="'$(UseWinUI)' == 'true' and '$(DesignTimeBuild)' == 'true'">
    <ItemGroup>
      <_XamlGeneratedCode Include="$(IntermediateOutputPath)**\*.g.cs;$(IntermediateOutputPath)**\*.g.i.cs" />
      <Compile Include="@(_XamlGeneratedCode)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
